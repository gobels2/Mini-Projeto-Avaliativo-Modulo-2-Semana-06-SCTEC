        "dataCategory": "Time",
        "columns": [
          {
            "name": "Date",
            "dataType": "dateTime",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "isKey": true,
            "sourceColumn": "[Date]",
            "formatString": "yyyy-mm-dd",
            "summarizeBy": "none",
            "type": "calculatedTableColumn"
          },
          {
            "name": "Ano",
            "dataType": "int64",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Ano]",
            "summarizeBy": "none",
            "type": "calculatedTableColumn"
          },
          {
            "name": "Mês",
            "dataType": "int64",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Mês]",
            "summarizeBy": "none",
            "type": "calculatedTableColumn"
          },
          {
            "name": "Nome do Mês",
            "dataType": "string",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Nome do Mês]",
            "summarizeBy": "none",
            "type": "calculatedTableColumn"
          },
          {
            "name": "Ano-Mês",
            "dataType": "string",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Ano-Mês]",
            "summarizeBy": "none",
            "type": "calculatedTableColumn"
          }
        ],
        "partitions": [
          {
            "name": "dCalendario-particao",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": "ADDCOLUMNS(\n    CALENDAR(MIN(fBPS[compra]), MAX(fBPS[compra])),\n    \"Ano\", YEAR([Date]),\n    \"Mês\", MONTH([Date]),\n    \"Nome do Mês\", FORMAT([Date], \"MMM\"),\n    \"Ano-Mês\", FORMAT([Date], \"YYYY-MM\")\n)"
            }
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "rel-dcal-fbps",
        "fromTable": "fBPS",
        "fromColumn": "compra",
        "toTable": "dCalendario",
        "toColumn": "Date",
        "crossFilteringBehavior": "oneDirection"
      }
    ],
    "annotations": [
