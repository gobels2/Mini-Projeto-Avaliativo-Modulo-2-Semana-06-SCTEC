            "expression": "fBPS[nome_instituicao] & \" · \" & fBPS[uf]",
            "summarizeBy": "none"
          }
        ],
        "measures": [
          {
            "name": "Valor Total Registrado",
            "expression": "SUM(fBPS[preco_total])",
            "formatString": "\"R$\" #,0;-\"R$\" #,0;\"R$\" #,0",
            "lineageTag": "med-0"
          },
          {
            "name": "Qtd Total de Itens",
            "expression": "SUM(fBPS[qtd_itens_comprados])",
            "formatString": "#,0",
            "lineageTag": "med-1"
          },
          {
            "name": "Nº de Registros",
            "expression": "COUNTROWS(fBPS)",
            "formatString": "#,0",
            "lineageTag": "med-2"
          },
          {
            "name": "Instituições Compradoras",
            "expression": "DISTINCTCOUNT(fBPS[cnpj_instituicao])",
            "formatString": "#,0",
            "lineageTag": "med-3"
          },
          {
            "name": "Fornecedores",
            "expression": "DISTINCTCOUNT(fBPS[cnpj_fornecedor])",
            "formatString": "#,0",
            "lineageTag": "med-4"
          },
          {
            "name": "Preço Unit. Médio Ponderado",
            "expression": "DIVIDE([Valor Total Registrado], [Qtd Total de Itens])",
            "formatString": "\"R$\" #,0.0000;-\"R$\" #,0.0000;\"R$\" #,0.0000",
            "lineageTag": "med-5"
          },
          {
            "name": "Valor Registros Atípicos",
            "expression": "CALCULATE([Valor Total Registrado], fBPS[flag_preco_atipico] = TRUE())",
            "formatString": "\"R$\" #,0;-\"R$\" #,0;\"R$\" #,0",
            "lineageTag": "med-6"
          },
          {
            "name": "% do Valor em Atípicos",
            "expression": "DIVIDE([Valor Registros Atípicos], [Valor Total Registrado])",
            "formatString": "0.0%",
            "lineageTag": "med-7"
          },
          {
            "name": "Preço Médio Pond. s/ Atípicos",
            "expression": "CALCULATE([Preço Unit. Médio Ponderado], fBPS[flag_preco_atipico] = FALSE())",
            "formatString": "\"R$\" #,0.0000;-\"R$\" #,0.0000;\"R$\" #,0.0000",
            "lineageTag": "med-8"
          }
        ],
        "partitions": [
          {
            "name": "fBPS-particao",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Fonte = Csv.Document(File.Contents(\"C:\\Users\\leona\\Desktop\\AI Ecommerce\\PROJETO FINAL LEO GOBEL TURMA 2\\MINIPROJETO M2S06\\Mini-Projeto-Avaliativo-Modulo-2-Semana-06-SCTEC\\data\\processed\\BPS_20_26_LeoGobel.csv\"), [Delimiter=\";\", Columns=33, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Promovido = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),",
                "    Tipado = Table.TransformColumnTypes(Promovido, {{\"ano_compra\", Int64.Type}, {\"nome_instituicao\", type text}, {\"esfera\", type text}, {\"cnpj_instituicao\", type text}, {\"municipio_instituicao\", type text}, {\"uf\", type text}, {\"compra\", type date}, {\"insercao\", type date}, {\"codigo_br\", type text}, {\"descricao_catmat\", type text}, {\"unidade_fornecimento\", type text}, {\"generico\", type text}, {\"anvisa\", type text}, {\"modalidade_compra\", type text}, {\"tipo_compra\", type text}, {\"capacidade\", type number}, {\"unidade_medida\", type text}, {\"unidade_fornecimento_capacidade\", type text}, {\"cnpj_fornecedor\", type text}, {\"fornecedor\", type text}, {\"cnpj_fabricante\", type text}, {\"fabricante\", type text}, {\"qtd_itens_comprados\", type number}, {\"preco_unitario\", type number}, {\"preco_total\", type number}, {\"arquivo_origem\", type text}, {\"tipo_produto\", type text}, {\"principio_ativo\", type text}, {\"regiao\", type text}, {\"n_grupo\", type number}, {\"mediana_grupo\", type number}, {\"razao_vs_mediana\", type number}, {\"flag_preco_atipico\", type logical}}, \"en-US\")",
                "in",
                "    Tipado"
              ]
            }
          }
        ]
      },
